# ──────────────────────────────────────
# BookMeUp18 — Variables d'environnement
# Copiez ce fichier en .env.local et remplissez les valeurs.
# ──────────────────────────────────────

# ── Firebase Client (public, exposées au navigateur) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (serveur uniquement, jamais exposées) ──
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Stripe ──
STRIPE_SECRET_KEY=                          # sk_test_xxx ou sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=         # pk_test_xxx ou pk_live_xxx
STRIPE_WEBHOOK_SECRET=                      # whsec_xxx (endpoint webhook)
STRIPE_PRICE_ID_STARTER=                    # price_xxx (plan Starter)
STRIPE_PRICE_ID_PRO=                        # price_xxx (plan Pro)
STRIPE_PRICE_ID_PREMIUM=                    # price_xxx (plan Premium)

# ── Resend (emails transactionnels) ──
RESEND_API_KEY=                             # re_xxx
EMAIL_FROM=noreply@votredomaine.com         # Expéditeur (doit être vérifié dans Resend)

# ── Google Calendar OAuth 2.0 (optionnel, plan Pro+) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Twilio SMS (optionnel, plan Premium) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── App ──
NEXT_PUBLIC_BASE_URL=http://localhost:3000  # URL de base (adapter en production)
